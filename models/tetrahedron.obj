# MeshForge sample model — tetrahedron
# 4 vertices, 4 triangular faces

mtllib tetrahedron.mtl

v  0.0  1.0  0.0
v  0.943  -0.333  0.0
v -0.471  -0.333  0.816
v -0.471  -0.333 -0.816

vn  0.0  0.0  1.0
vn  0.816  0.0 -0.333
vn -0.816  0.0 -0.333
vn  0.0  0.0 -1.0

g tetrahedron
usemtl silver

f 1//1 3//1 2//1
f 1//2 2//2 4//2
f 1//3 4//3 3//3
f 2//4 3//4 4//4
